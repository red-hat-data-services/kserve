# Build the manager binary
FROM registry.access.redhat.com/ubi9/go-toolset:1.26@sha256:c51f0f31cbaa7e91dede6013f636d54fe10dd7d581cfc4cda014ba9d62bcd779 AS builder
ENV PATH="$PATH:/opt/app-root/src/go/bin"

# These built-in args are defined in the global scope, and are not automatically accessible within build stages or RUN commands.
# To expose these arguments inside the build stage, we need to redefine it without a value.
ARG TARGETOS TARGETARCH
RUN echo "GOOS=${TARGETOS} GOARCH=${TARGETARCH}"

USER root
WORKDIR /go/src/github.com/opendatahub-io/kserve-module
COPY kserve-module/go.mod  go.mod
COPY kserve-module/go.sum  go.sum
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY kserve-module/cmd/kserve-module/ cmd/kserve-module/
COPY kserve-module/pkg/              pkg/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFLAGS=-mod=readonly GOEXPERIMENT=strictfipsruntime  go build -tags strictfipsruntime -a -o manager ./cmd/kserve-module

# Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed
RUN microdnf install -y shadow-utils && \
    microdnf clean all && \
    useradd kserve -m -u 1000 && \
    microdnf remove -y shadow-utils
COPY --from=builder /go/src/github.com/opendatahub-io/kserve-module/manager /manager
COPY kserve-module/prefetched-manifests-rhoai /opt/manifests-template/
COPY config/ /opt/manifests-template/kserve/
USER 1000:1000
ENTRYPOINT ["/manager"]
